# Public-safe example only. Do not put real secrets in git.
# The gateway speaks plain HTTP; run it behind a TLS-terminating reverse proxy
# (docs/operations.md). GATEWAY_HOST=127.0.0.1 keeps it off the network until then.
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8080
# Static token store: {"tokens": [{"token": ..., "actor": ..., "project": ..., "roles": [...]}]}
# — see config/examples/tokens.example.json for the full shape.
# Hot-reloaded on change. Keep it mode 0600 and outside any repository.
# Required unless OIDC_ISSUER is set (see the OIDC block below).
GATEWAY_TOKEN_FILE=/etc/mcp-governance-gateway/tokens.json
# Optional second store for tokens minted at runtime (a portal, an admin tool);
# same format, may be absent or empty. Its per-token labels also drive the
# readable actor names in memory/docs listings.
# GATEWAY_USER_TOKEN_FILE=/var/lib/mcp-governance-gateway/user-tokens.json
# Browser-origin allow-list for the MCP endpoint (DNS-rebinding defence): a
# request carrying an Origin header not listed here is refused. This is an
# allow-list check, not CORS -- no CORS headers are emitted.
GATEWAY_ALLOWED_ORIGINS=https://agent.example.internal

# Signed identity headers from a front gateway (optional, ADR-0004). When the
# secret is set, `<prefix>-Id` / `<prefix>-Email` are trusted only with a valid
# `<prefix>-Claims-Signature` (HMAC-SHA256), and the verified user becomes the
# acting identity for audit and attribution. The bearer token still authorizes.
# IDENTITY_CLAIMS_SECRET=replace-with-shared-hmac-secret
# IDENTITY_HEADER_PREFIX=X-Forwarded-User

# OIDC (ADR-0016). Optional second authenticator BESIDE the token file, not a
# replacement: the token file is consulted first, and a deployment that sets none
# of these behaves exactly as before. Setting OIDC_ISSUER makes GATEWAY_TOKEN_FILE
# optional, since an IdP-only deployment has no opaque tokens to store.
# The IdP supplies WHO (a verified, immutable `sub` -> actor; ADR-0007). It does
# NOT supply which project of this gateway they may act in: tenancy comes from
# OIDC_GRANTS_FILE, which this deployment owns. A `project` claim in a token is
# ignored.
# OIDC_ISSUER=https://sso.example.internal/realms/main
# OIDC_AUDIENCE=mcp-governance-gateway    # required; no default, on purpose --
#                                         # an issuer mints tokens for many clients
# OIDC_GRANTS_FILE=/etc/mcp-governance-gateway/oidc-grants.json
#     {"subjects": {"<sub>": {"project": "...", "issue_project": "...", "roles": [...]}},
#      "groups":   {"<group>": {"project": "...", "roles": [...]}}}
#     Resolved by subject first, then by group. Two groups naming different
#     projects are refused rather than resolved. No match -> no project -> denied.
# OIDC_JWKS_URL=                          # unset -> discovered from the issuer
# OIDC_GROUPS_CLAIM=groups
# OIDC_REQUIRED_SCOPE=                    # unset -> scope is not checked
# OIDC_CLOCK_SKEW_SEC=60
# OIDC_JWKS_TTL_SEC=600
# Signature algorithms are an allow-list in code (RS256/384/512, ES256/384/512).
# `alg: none` and every HMAC algorithm are refused by name: the JWKS publishes
# PUBLIC keys, so accepting HS256 would let anyone who can read it mint a token.

# Every *_BASE_URL is checked at startup: an http:// or https:// URL (ASCII);
# an empty optional one means "not configured". Every *_TIMEOUT_SEC is seconds,
# greater than 0 and at most 3600.
REDMINE_BASE_URL=https://redmine.example.internal/
REDMINE_API_KEY=replace-with-redmine-api-key
REDMINE_TIMEOUT_SEC=10
# Per-user Redmine keys, encrypted at rest (ADR-0009). When the store is set,
# issue writes use the caller's own enrolled key; the enforce flag makes a
# missing personal key fail loud instead of falling back to REDMINE_API_KEY.
# REDMINE_KEYSTORE_FILE=/var/lib/mcp-governance-gateway/redmine-keys.json
# REDMINE_KEYSTORE_MASTER_FILE=/etc/mcp-governance-gateway/keystore.master
# REDMINE_ENFORCE_PERSONAL_KEY=1

MEMORY_BASE_URL=http://memory.internal:3111
# Bearer token the gateway presents to the memory backend, if it needs one.
# MEMORY_BACKEND_TOKEN=...
MEMORY_SEARCH_PATH=/agentmemory/search
MEMORY_SAVE_PATH=/agentmemory/remember
MEMORY_LIST_PATH=/agentmemory/memories
MEMORY_LESSON_PATH=/agentmemory/lessons
MEMORY_ACTION_PATH=/agentmemory/actions
MEMORY_TIMEOUT_SEC=10
MEMORY_SAVE_MAX_TEXT_BYTES=32768
MEMORY_USER_WRITES_PER_MINUTE=30
MEMORY_PROJECT_WRITES_PER_DAY=5000
MEMORY_USER_READS_PER_MINUTE=120

# Where a user enrolls their own downstream credential (a personal Redmine key or
# GitLab PAT). Appended to the errors that ask a caller to enroll or re-enroll,
# so the message can point somewhere. Unset -> those errors carry no URL.
# CREDENTIAL_PORTAL_URL=https://mcp-gateway.example.internal/admin/credentials

# Docs corpus (docs.search/docs.get) — enabled only when both are set.
# DOCS_REPOS_FILE=/etc/mcpgw/docs-repos.json   # {"<project>": {"url": "...", "branch": "master"}}
# DOCS_CLONE_DIR=/var/lib/mcpgw/docs
# DOCS_PULL_INTERVAL_SEC=300

# Issue backend selection (ADR-0013). Default: redmine.
# ISSUE_BACKEND=gitlab
# GITLAB_BASE_URL=https://gitlab.example.com
# GITLAB_TOKEN=...          # shared token; users may enroll their own PAT in the credential store
# GITLAB_TIMEOUT_SEC=10
# GITLAB_ENFORCE_PERSONAL_KEY=1   # writes require the caller's own PAT (needs REDMINE_KEYSTORE_FILE)

# Jenkins CI (read-only ci.status / ci.builds / ci.log / ci.artifact) — enabled
# when url + jobs file are set.
# JENKINS_BASE_URL=https://jenkins.example.com
# JENKINS_USER=svc-ci-reader
# JENKINS_TOKEN=...
# JENKINS_TIMEOUT_SEC=10
# CI_JOBS_FILE=/etc/mcpgw/ci-jobs.json   # {"<project>": ["job-name", ...]}
# Public base for the download URLs ci.artifact returns. Unset -> they come back
# relative ("/ci/artifact?...") for the caller to resolve against its own origin.
# CI_ARTIFACT_BASE_URL=https://mcp-gateway.example.internal
# Bounds on the artifact data plane: the bytes bypass every tool-level limit, so
# these are the only thing standing between one surprise artifact (or a few slow
# clients) and the gateway's thread pool.
# CI_ARTIFACT_MAX_BYTES=268435456      # 256 MB; a larger declared size is a 413
# CI_ARTIFACT_MAX_CONCURRENT=4         # further downloads get 503, not a queue
